# Environment Configuration for A24 Healthcare Multi-Agent Backend
PROJECT_NAME="A24 Multi-Agent Healthcare Platform"
ENVIRONMENT="development"
DEBUG=true

# Neon PostgreSQL connection string (Async SQLAlchemy asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<ep-project-id>.pooler.neon.tech/<dbname>?ssl=require
DATABASE_URL="sqlite+aiosqlite:///./a24_healthcare.db"
# Replace with your Neon connection string in production:
# NEON_DATABASE_URL="postgresql+asyncpg://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?ssl=require"

# Cloudflare Gemini Key Proxy
CLOUDFLARE_GEMINI_PROXY_URL="http://127.0.0.1:8787"
INTERNAL_PROXY_SECRET="a24-healthcare-internal-key-secret-2026"

# Fallback Direct Gemini Key (if Cloudflare proxy is offline during local test)
GEMINI_DIRECT_API_KEY=""

# Google Workspace / OAuth Credentials (optional; fallback mock simulator runs if absent)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GMAIL_SENDER_EMAIL="concierge@a24med.ai"

# CORS origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
